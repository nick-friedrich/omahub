APP_NAME=Omahub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Optional, but recommended to increase GitHub API rate limits.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_USER_AGENT=Omahub

# GitHub OAuth App credentials for sign-in (https://github.com/settings/developers).
# The Authorization callback URL must be <APP_URL>/auth/github/callback.
# GITHUB_ADMIN_USERNAMES is a comma-separated list of logins granted admin access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_ADMIN_USERNAMES=

# Deterministic security scan. Downloads the repo tarball and runs static
# rules inside a Docker sandbox. Set SCAN_SANDBOX_ENABLED=false to scan on the
# host instead (local dev / tests).
#
# The sandbox image is a LOCAL tag — built on the server from a server-only
# Dockerfile or reusing the app's own runtime image; never a registry image
# (scripts/deploy.sh handles this on production). SCAN_SANDBOX_HOST_REPO_PATH is
# the host path of this repo when the app itself runs in Docker and talks to the
# host daemon (Docker-out-of-Docker); leave unset when PHP runs on the host.
SCAN_SANDBOX_ENABLED=false
SCAN_SANDBOX_IMAGE=
SCAN_SANDBOX_HOST_REPO_PATH=
SCAN_MAX_FILE_SIZE=2097152
SCAN_MAX_FILES=2000

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
